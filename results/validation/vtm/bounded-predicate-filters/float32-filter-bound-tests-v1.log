                cases.append(q)
            q = p.copy()
            q[:, 2] = q[0, 2]
            cases.append(q)
        for order in permutations(range(4)):
            cases.append(base[[*order, 4]])
        for tiny in [np.nextafter(np.float32(0), np.float32(1)), np.finfo(np.float32).tiny]:
            for axis in range(3):
                p = base.copy()
                p[:, axis] *= tiny
